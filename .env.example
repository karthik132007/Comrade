# Comrade configuration. Copy to .env and fill in values.
# Secrets stay in the Rust backend only — never exposed to the frontend.

# Main reasoning brain (DeepSeek-direct API). Default model is the flash tier.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash

# OpenRouter (voice STT/TTS + memory embeddings; DeepSeek has no audio API)
OPENROUTER_API_KEY=

# Phase 2 voice models (OpenRouter). Defaults are live models as of Sep 2026;
# verify current IDs via GET /api/v1/models?output_modalities=speech|transcription.
STT_MODEL=openai/whisper-large-v3
TTS_MODEL=mistralai/voxtral-mini-tts-2603
TTS_VOICE=en_paul_neutral

# Vector memory embeddings (OpenRouter, OpenAI-compatible /embeddings).
# DIM must match the model: text-embedding-3-small = 1536.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Everything Comrade owns lives under one folder ("comrade-agent home"):
#   Linux/macOS: $COMRADE_HOME, else $XDG_CONFIG_HOME/comrade-agent, else ~/.config/comrade-agent
#   Windows:     %APPDATA%/comrade-agent
# Override the whole home with COMRADE_HOME if you want it elsewhere.
# COMRADE_HOME=

# Persistent Brave/Chromium profile dir for authenticated sessions.
# Leave commented out to use the platform default
# (<comrade-agent home>/brave-profile).
# COMRADE_PROFILE_DIR=~/.config/comrade-agent/brave-profile

# OpenCode binary
OPENCODE_BIN=opencode

# Agent loop guardrails
AGENT_MAX_STEPS=15
AGENT_TIMEOUT_MS=120000
