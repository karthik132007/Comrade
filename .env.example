# Comrade configuration. Copy to .env and fill in values.
# Secrets stay in the Rust backend only — never exposed to the frontend.

# Main reasoning brain (DeepSeek-direct API). Default model is the flash tier.
# Non-secret fallback lives in comrade.conf [llm] (ENV > .env > conf).
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash

# OpenRouter (voice STT/TTS + memory embeddings; DeepSeek has no audio API)
OPENROUTER_API_KEY=

# Voice I/O is fully local (sherpa-onnx). No cloud speech keys exist.
# Configure voice in comrade.conf [voice], [voice.vad], [voice.tts], [voice.runtime]
# (~/.config/comrade-agent/comrade.conf). Precedence: ENV > .env > comrade.conf.

# Vector memory embeddings (OpenRouter, OpenAI-compatible /embeddings).
# DIM must match the model: text-embedding-3-small = 1536.
# Non-secret fallback lives in comrade.conf [memory].
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Everything Comrade owns lives under one folder ("comrade-agent home"):
#   Linux/macOS: $COMRADE_HOME, else $XDG_CONFIG_HOME/comrade-agent, else ~/.config/comrade-agent
#   Windows:     %APPDATA%/comrade-agent
# Override the whole home with COMRADE_HOME if you want it elsewhere.
# COMRADE_HOME=

# Persistent Brave/Chromium profile dir for authenticated sessions.
# Persistent browser profile dir for the selected browser (single shared dir —
# never per-browser duplicates). Leave commented for the platform default
# (<comrade-agent home>/browser-profile).
#COMRADE_PROFILE_DIR=~/.config/comrade-agent/browser-profile

# Coding agents are picked in onboarding/Settings (comrade.conf [coding]).
# Detected: opencode, claude, codex, copilot, qwen, kimi, deepseek, antigravity.

# Agent loop guardrails (non-secret fallback in comrade.conf [agent]).
AGENT_MAX_STEPS=15
AGENT_TIMEOUT_MS=120000

# Comrade service backend (optional): one server for LLM, embeddings, STT,
# TTS instead of direct cloud APIs. Precedence: ENV > .env > comrade.conf
# [server]. When set, the brain + memory use the server; set voice backend
# to "server" in Settings ([voice] backend) for server speech too, which
# makes local model downloads optional. Brain changes apply after restart.
#COMRADE_SERVER_ENABLED=true
#COMRADE_SERVER_URL=http://localhost:8000
#COMRADE_SERVER_KEY=
#COMRADE_SERVER_LLM_MODEL=deepseek-flash   # one of the 4 allowed ids (Settings dropdown)
#COMRADE_SERVER_EMBEDDING_MODEL=comrade-embed
#COMRADE_SERVER_EMBEDDING_DIM=1536
#COMRADE_SERVER_STT_MODEL=comrade-stt
#COMRADE_SERVER_TTS_VOICE=default
# Voice backend without editing conf: server (default) or local.
#COMRADE_VOICE_BACKEND=server

